{
  "id": "voice-agent",
  "name": "Voice Agent",
  "description": "Talk to an agent through the gateway or a paired node's microphone and speaker.",
  "enabledByDefault": false,
  "commandAliases": [{ "name": "voice-agent" }],
  "activation": {
    "onCommands": ["voice-agent"],
    "onCapabilities": ["node-host"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "autoStart": {
        "type": "boolean",
        "description": "Start listening on the gateway host (or `node`) when the gateway starts."
      },
      "node": {
        "type": "string",
        "description": "Default node id/name whose microphone and speaker are used. Omit for the gateway host."
      },
      "agentId": { "type": "string" },
      "stt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string" },
          "providers": { "type": "object", "additionalProperties": { "type": "object" } }
        }
      },
      "audioInputCommand": { "type": "array", "items": { "type": "string" } },
      "audioOutputCommand": { "type": "array", "items": { "type": "string" } }
    }
  }
}
